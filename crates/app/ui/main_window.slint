import { LineEdit, ListView, Palette, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One line of the file list, already formatted for display.
export struct EntryRow {
    name: string,
    modified: string,
    kind: string,
    size: string,
}

export component MainWindow inherits Window {
    title: "findy-file";
    preferred-width: 800px;
    preferred-height: 500px;
    background: Theme.background;

    in-out property <string> current-path;
    in property <[EntryRow]> entries;

    // Column widths, shared by the headers and the rows. Name takes the rest.
    property <length> modified-width: 150px;
    property <length> kind-width: 110px;
    property <length> size-width: 80px;

    VerticalLayout {
        // A: top bar with the path input.
        Rectangle {
            background: Theme.accent;
            // Keep the bar at its natural height; only B and C grow.
            vertical-stretch: 0;

            HorizontalLayout {
                padding: 8px;

                LineEdit {
                    text <=> root.current-path;
                    placeholder-text: "Type a path";
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // B: sidebar.
            Rectangle {
                width: 180px;
                background: Theme.surface;

                VerticalLayout {
                    padding: 16px;
                    alignment: start;

                    Switch {
                        text: "Dark mode";
                        checked: Theme.dark;
                        toggled => {
                            Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            // C: items in the current folder, with column headers.
            VerticalLayout {
                HorizontalLayout {
                    height: 32px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;

                    Text {
                        text: "Name";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "Date modified";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        width: root.modified-width;
                    }

                    Text {
                        text: "Type";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        width: root.kind-width;
                    }

                    Text {
                        text: "Size";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: root.size-width;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                ListView {
                    for row in root.entries: Rectangle {
                        height: 28px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            Text {
                                text: row.name;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: row.modified;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: root.modified-width;
                            }

                            Text {
                                text: row.kind;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                width: root.kind-width;
                            }

                            Text {
                                text: row.size;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: root.size-width;
                            }
                        }
                    }
                }
            }
        }
    }
}
